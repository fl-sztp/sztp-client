[Unit]
Description=Secure Zero Touch Provisioning client
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/sztp-client

[Service]
Type=exec
User=root
ExecStart=/usr/local/bin/sztp-client --config=/etc/sztp-client/config.yaml
TimeoutStartSec=0
Restart=on-failure
RestartSec=60s

[Install]
WantedBy=multi-user.target
